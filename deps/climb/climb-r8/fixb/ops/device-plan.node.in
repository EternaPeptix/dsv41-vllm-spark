mac2|fixb-stage|bash @KIT@/ops/stage.sh stage
spark-two|fixb-head-synth|for i in $(seq 1 120); do [ -f $HOME/climb-scratch/r8-fixb/.staged ] && break; sleep 10; done; [ -f $HOME/climb-scratch/r8-fixb/.staged ] || { echo 'r8-fixb not staged after 20 min'; exit 3; }; source $HOME/venvs/vllm032/bin/activate && export PATH=/usr/local/cuda/bin:$PATH CUDA_HOME=/usr/local/cuda && cd $HOME/climb-scratch/r8-fixb/head && export TRITON_CACHE_DIR=$HOME/climb-scratch/r8-fixb/tcache-head && timeout 3600 python device_test.py --part all --expect @EXPECT@ --json results/dt-synth.json; echo fixb-head synth rc=$?
spark-two|fixb-head-real|for i in $(seq 1 120); do [ -f $HOME/climb-scratch/r8-fixb/.staged ] && break; sleep 10; done; [ -f $HOME/climb-scratch/r8-fixb/.staged ] || { echo 'r8-fixb not staged after 20 min'; exit 3; }; source $HOME/venvs/vllm032/bin/activate && export PATH=/usr/local/cuda/bin:$PATH CUDA_HOME=/usr/local/cuda && cd $HOME/climb-scratch/r8-fixb/head && export TRITON_CACHE_DIR=$HOME/climb-scratch/r8-fixb/tcache-head && timeout 3600 python device_test.py --part all --weights real --rank 4 --model $HOME/models/dsv41/official-fp8 --expect @EXPECT@ --json results/dt-real.json; echo fixb-head real rc=$?
spark-three|fixb-step-dt|for i in $(seq 1 120); do [ -f $HOME/climb-scratch/r8-fixb/.staged ] && break; sleep 10; done; [ -f $HOME/climb-scratch/r8-fixb/.staged ] || { echo 'r8-fixb not staged after 20 min'; exit 3; }; source $HOME/venvs/vllm032/bin/activate && export PATH=/usr/local/cuda/bin:$PATH CUDA_HOME=/usr/local/cuda && cd $HOME/climb-scratch/r8-fixb/step && export TRITON_CACHE_DIR=$HOME/climb-scratch/r8-fixb/tcache-step && timeout 2700 python3 device_test.py --source kit --part all --model $HOME/models/dsv41/official-fp8 --expect @EXPECT@; echo fixb-step device_test rc=$?
spark-four|fixb-skew-dt|for i in $(seq 1 120); do [ -f $HOME/climb-scratch/r8-fixb/.staged ] && break; sleep 10; done; [ -f $HOME/climb-scratch/r8-fixb/.staged ] || { echo 'r8-fixb not staged after 20 min'; exit 3; }; source $HOME/venvs/vllm032/bin/activate && export PATH=/usr/local/cuda/bin:$PATH CUDA_HOME=/usr/local/cuda && cd $HOME/climb-scratch/r8-fixb/skew && timeout 900 python3 device_test.py --core 16 --expect @EXPECT@; echo fixb-skew device_test rc=$?
