+    def _l3_open_string(
+        self, slot: ToolCallSlot, current_json: str, safe_json: str
+    ) -> bool:
+        """After a full flush: does the streamed JSON end inside the string value of the
+        parameter that is still open in the raw DSML text, holding exactly its raw value?
+
+        Then the JSON's prefix grows by ``json.dumps(new_text)[1:-1]`` for every later
+        piece of the value (escaping is per character), which is what the full
+        conversion would emit, until a DSML tag arrives.
+        """
+        if self._l3_head_re is None:
+            return False
+        if not current_json.endswith('"}') or safe_json != current_json[:-2]:
+            return False
+        args = slot.args
+        start = args.rfind(self._l3_param_start)
+        if start < 0 or args.find(self._l3_param_close, start) >= 0:
+            return False
+        head = self._l3_head_re.match(args, start)
+        if head is None or head.group(2) != "true":
+            return False
+        value = args[head.end() :]
+        if _L3_DSML_MARK in value:
+            return False
+        try:
+            parsed = json.loads(current_json)
+        except (json.JSONDecodeError, ValueError):
+            return False
+        if not isinstance(parsed, dict) or not parsed:
+            return False
+        last_key = next(reversed(parsed))
+        return last_key == head.group(1) and parsed[last_key] == value
